# Arca - configuração. Copie para .env (o `make subir` faz isso automaticamente).

# Porta publicada pelo Caddy (único serviço exposto no host)
ARCA_PORTA=80

# IP do host onde o Caddy escuta. Use o IP da LAN (ex.: 192.168.1.10).
# NUNCA use 0.0.0.0 em máquina com IP público: o Arca não tem autenticação.
# O `make subir` preenche com o IP da LAN detectado; 127.0.0.1 = só a própria máquina.
ARCA_ENDERECO=127.0.0.1

# UID/GID dono dos arquivos de notas em data/flatnotes (o `make subir` preenche)
ARCA_UID=1000
ARCA_GID=1000

# MariaDB (troque as senhas)
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=arca
MARIADB_USER=arca
MARIADB_PASSWORD=change-me-arca

# Imagens com versão e digest fixos (mariadb 11.4 = série LTS)
ARCA_IMAGEM_MARIADB=mariadb:11.4.5@sha256:49117dcc565cf51aa57ac5fca59ab31213402ff0eae6ffc13c46a37b938f7e4b
ARCA_IMAGEM_CADDY=caddy:2.9.1-alpine@sha256:b4e3952384eb9524a887633ce65c752dd7c71314d2c2acf98cd5c715aaa534f0
ARCA_IMAGEM_FLATNOTES=dullage/flatnotes:v5.5.4@sha256:a509830073d6548d35450a98be3a432716430b674cc70ac93cbbaed1555b5a28
ARCA_IMAGEM_PYTHON=python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
ARCA_IMAGEM_KIWIX=ghcr.io/kiwix/kiwix-serve:3.7.0@sha256:e63549867bc2bdcb94fb90a952f1bfbf9d23245bebafa4b04d33faf0c1518031

# Perfis opcionais (tags fixas; digest do índice multi-arch)
ARCA_IMAGEM_LIBRETRANSLATE=libretranslate/libretranslate:v1.9.6@sha256:1de2d7056bb8ad607a412f4563d9abe324ff632b43b5be9428bcc8e213aebb32
ARCA_IMAGEM_KOLIBRI=learningequality/kolibri:0.19.5@sha256:19810f674f1e94a4f925f4f45f8a45de1735310e83540361c4e8614eca34a9fe
ARCA_IMAGEM_KAVITA=jvmilazz0/kavita:0.9.1@sha256:31181a32f0dda73cae68721867028a7253d57881b58bea5754cd9e578e75421a
ARCA_IMAGEM_JELLYFIN=jellyfin/jellyfin:10.11.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db

# Idiomas do LibreTranslate (modelos baixados por `make modelos-traducao`)
LT_LOAD_ONLY=en,pt,es

# Perfis opcionais do Compose (cursos, midia, traducao), separados por vírgula.
# O portal mostra serviços de perfis desligados como "desativado".
COMPOSE_PROFILES=
